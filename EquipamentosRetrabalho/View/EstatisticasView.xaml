<UserControl x:Class="EquipamentosRetrabalho.View.EstatisticasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EquipamentosRetrabalho.View"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20" Orientation="Vertical">

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="100,60,10,0">
                    <TextBlock Text="Quantidade de Motores e Redutores:" FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center" FontSize="18"/>
                    <lvc:CartesianChart
                        Series="{Binding Series}"
                        XAxes="{Binding XAxes}"
                        YAxes="{Binding YAxes}"
                        DrawMargin="{Binding DrawMargin}"
                        DrawMarginFrame="{x:Null}"
                        Height="300"
                        Width="600"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="10,60,100,70">
                    <TextBlock Text="Total de Equipamentos:" FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center" FontSize="18"/>
                    <lvc:CartesianChart
                        Series="{Binding SeriesTotalPorMes}"
                        XAxes="{Binding XAxes}"
                        YAxes="{Binding YAxes}"
                        DrawMargin="{Binding DrawMargin}"
                        DrawMarginFrame="{x:Null}"
                        Height="300"
                        Width="600"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="170,0,10,0">
                    <TextBlock Text="Quantidade de cada tipo de redutor:" FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center" FontSize="18"/>
                    <lvc:PieChart 
                        Series="{Binding RedutoresPieSeries}" 
                        LegendPosition="Right" 
                        Height="300"
                        Width="400"/>
                    <ComboBox Width="150"
                              SelectedValue="{Binding MesSelecionadoTipoRedutor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Content"
                              SelectedIndex="-1">
                        <ComboBoxItem>Todos</ComboBoxItem>
                        <ComboBoxItem>Janeiro</ComboBoxItem>
                        <ComboBoxItem>Fevereiro</ComboBoxItem>
                        <ComboBoxItem>Março</ComboBoxItem>
                        <ComboBoxItem>Abril</ComboBoxItem>
                        <ComboBoxItem>Maio</ComboBoxItem>
                        <ComboBoxItem>Junho</ComboBoxItem>
                        <ComboBoxItem>Julho</ComboBoxItem>
                        <ComboBoxItem>Agosto</ComboBoxItem>
                        <ComboBoxItem>Setembro</ComboBoxItem>
                        <ComboBoxItem>Outubro</ComboBoxItem>
                        <ComboBoxItem>Novembro</ComboBoxItem>
                        <ComboBoxItem>Dezembro</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="10,0,170,70">
                    <TextBlock Text="Tempo médio de finalização por tipo de redutor:" FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center" FontSize="18"/>
                    <lvc:PieChart 
                        Series="{Binding TempoMedioFinalização }" 
                        LegendPosition="Right" 
                        Height="300"
                        Width="400"/>
                    <ComboBox Width="150"
          SelectedValue="{Binding MesSelecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          SelectedValuePath="Content">
                        <ComboBoxItem IsSelected="True" IsEnabled="False">Selecione um mês</ComboBoxItem>
                        <ComboBoxItem>Todos</ComboBoxItem>
                        <ComboBoxItem>Janeiro</ComboBoxItem>
                        <ComboBoxItem>Fevereiro</ComboBoxItem>
                        <ComboBoxItem>Março</ComboBoxItem>
                        <ComboBoxItem>Abril</ComboBoxItem>
                        <ComboBoxItem>Maio</ComboBoxItem>
                        <ComboBoxItem>Junho</ComboBoxItem>
                        <ComboBoxItem>Julho</ComboBoxItem>
                        <ComboBoxItem>Agosto</ComboBoxItem>
                        <ComboBoxItem>Setembro</ComboBoxItem>
                        <ComboBoxItem>Outubro</ComboBoxItem>
                        <ComboBoxItem>Novembro</ComboBoxItem>
                        <ComboBoxItem>Dezembro</ComboBoxItem>
                    </ComboBox>

                </StackPanel>
            </Grid>

            <DataGrid ItemsSource="{Binding DefeitosOrdenados}" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" 
                      Margin="10" FontSize="14" RowHeaderWidth="0" Width="406" HorizontalAlignment="Center">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rank" Binding="{Binding PosicaoFormatada}" Width="50"/>
                    <DataGridTextColumn Header="Defeito" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Porcentagem" Binding="{Binding PercentualFormatado}" Width="84"/>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
